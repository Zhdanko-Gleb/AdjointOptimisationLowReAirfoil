FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 2 -2 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    Side
    {
        type            empty;
    }

    Airfoil
    {
        type            zeroGradient;
    }

    // pressure
    // {
    //     type            zeroGradient;
    // }

    Inlet
    {
        type            zeroGradient;
        outletValue     uniform 0;
        value           uniform 0;
    }
    Outlet
    {
        type            outletInlet;
        outletValue     uniform 0;
        value           uniform 0;
    }
}


